# Copy to .env and adjust before running.

# This password is for the SSH transport user named "bbs".
# The BBS app will still ask callers for their callsign/handle after login.
BBS_USER_PASSWORD=change-this-password

# Set true to let callers use "ssh bbs@host -p 2222" without a password.
# SSH still requires a username; use "bbs" as the shared transport user.
BBS_GUEST_MODE=false

BBS_NAME=HAMNET RADIO BBS
BBS_SYSOP=Sysop

# Comma-separated callsigns used to bootstrap the first sysop.
# Read only while no active sysop exists; ignored afterwards.
# Example: BBS_SYSOPS=EA1ABC,DL1ABC
BBS_SYSOPS=

BBS_LOCATION=HamNet
BBS_WELCOME_TOPIC=Amateur radio notes, local nets, and packet-era experiments
BBS_DB_FILE=/var/lib/bbs/bbs.sqlite

# APRS-IS settings used by the APRS messaging screen.
APRS_IS_SERVER=rotate.aprs2.net
APRS_IS_PORT=14580
APRSD_BIN=/opt/aprsd/bin/aprsd

# APRS-IS login callsign for the receive-only background listener.
# Set this to your station or club callsign before operating on APRS-IS.
APRS_RECEIVER_CALLSIGN=N0CALL

# Used only when the shared HamNet container namespace has no default route,
# such as local development without a valid WireGuard config.
BBS_FALLBACK_GATEWAY=172.18.0.1

# Outbound email (registration activation, password reset, email change).
# Defaults below match a Mailcow server; replace them with your own values.
# Mail stays disabled until every value below is real: the host and sender must
# be set, and the password must not be a placeholder. A placeholder password is
# refused outright (logged as mail_disabled at startup) rather than half-enabling
# mail and failing every send.
# BBS_SMTP_SECURITY is "starttls" (submission port 587), "tls" (port 465) or
# "none" (local relay only — never for a public server).
BBS_SMTP_HOST=mail.spainip.es
BBS_SMTP_PORT=587
BBS_SMTP_SECURITY=starttls
BBS_SMTP_USERNAME=bbs@ea7klk.es
BBS_SMTP_PASSWORD=change-this-smtp-password
BBS_SMTP_FROM=bbs@ea7klk.es
BBS_SMTP_FROM_NAME=HAMNET Radio BBS

# Public base URL of the web BBS. Activation, reset and email-change links point
# here, never at the SSH service.
BBS_WEB_BASE_URL=https://bbs.ea7klk.es

# Set to false when APRS reception runs in its own container, so a redeploy of
# the SSH service or the web app cannot interrupt it.
# BBS_APRS_EMBEDDED=true
# Set to false in any container that is not the SSH service.
# BBS_SSH_ENABLED=true
